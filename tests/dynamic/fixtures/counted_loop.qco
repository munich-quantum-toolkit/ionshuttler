module attributes {mqt.layout = {initial = array<i64: 0, 1, 2>, input_count = 3 : i64, sites = array<i64: 0, 1, 2>}, mqt.target_env = #mqt.target_env<compilation_target = <sites = [<id = 0>, <id = 1>, <id = 2>], connectivity = all_to_all, couplings = [], native_operations = explicit, operations = [<name = "rx", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "ry", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "rz", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "rxx", arity = <kind = fixed, value = 2>, num_parameters = 1, site_tuples = []>, <name = "measure", arity = <kind = fixed, value = 1>, num_parameters = 0, site_tuples = []>, <name = "reset", arity = <kind = fixed, value = 1>, num_parameters = 0, site_tuples = []>]>, payload_specification = <format = <id = "qco", version = "1.0.0", profile = "", encoding = text>, capabilities = [<id = "forward-branching", value = 0, constraints = []>, <id = "counted-iteration", value = 0, constraints = []>, <id = "conditional-loop", value = 0, constraints = []>], optional_capabilities_known = false>>} {
  func.func @main() -> !cbit.reg<2> attributes {mqt.entry_point} {
    %cst = arith.constant 1.5707963267948966 : f64
    %cst_0 = arith.constant -3.1415926535897931 : f64
    %cst_1 = arith.constant -1.5707963267948966 : f64
    %c0_i2 = arith.constant 0 : i2
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c3 = arith.constant 3 : index
    %q = qco.static 0 : !qco.qubit
    %q_2 = qco.static 1 : !qco.qubit
    %q_3 = qco.static 2 : !qco.qubit
    %c = cbit.alloc(#cbit.init<undefined>) {mqt.register_name = "c"} : !cbit.reg<2>
    cbit.write %c0_i2, %c : i2, !cbit.reg<2>
    %q_4, %q_5, %q_6 = scf.for %arg0 = %c0 to %c3 step %c1 iter_args(%q_7 = %q, %q_8 = %q_2, %q_9 = %q_3) -> (!qco.qubit, !qco.qubit, !qco.qubit) {
      %q_10 = qco.reset %q_9 : !qco.qubit
      %q_11 = qco.rz(%cst_0) %q_10 : !qco.qubit
      %q_12 = qco.rz(%cst_1) %q_7 : !qco.qubit
      %q_13 = qco.rx(%cst) %q_12 : !qco.qubit
      %q_14 = qco.rz(%cst) %q_13 : !qco.qubit
      %qubit0_out, %qubit1_out = qco.rxx(%cst_1) %q_14, %q_11 : !qco.qubit, !qco.qubit
      %q_15 = qco.rx(%cst) %qubit1_out : !qco.qubit
      %q_16 = qco.rz(%cst_1) %qubit0_out : !qco.qubit
      %q_17 = qco.rx(%cst_1) %q_16 : !qco.qubit
      %q_18 = qco.rz(%cst_1) %q_8 : !qco.qubit
      %q_19 = qco.rx(%cst) %q_18 : !qco.qubit
      %q_20 = qco.rz(%cst) %q_19 : !qco.qubit
      %qubit0_out_21, %qubit1_out_22 = qco.rxx(%cst_1) %q_20, %q_15 : !qco.qubit, !qco.qubit
      %q_23 = qco.rx(%cst) %qubit1_out_22 : !qco.qubit
      %q_24 = qco.rz(%cst_0) %q_23 : !qco.qubit
      %q_25 = qco.rz(%cst_1) %qubit0_out_21 : !qco.qubit
      %q_26 = qco.rx(%cst_1) %q_25 : !qco.qubit
      %q_27, %b = qco.measure %q_24 : !qco.qubit
      cbit.store %b, %c[%c0] : !cbit.reg<2>
      %linearResults = qco.if %b args(%q_28 = %q_17) -> (!qco.qubit) {
        %q_29 = qco.rz(%cst_1) %q_28 : !qco.qubit
        %q_30 = qco.rx(%cst_0) %q_29 : !qco.qubit
        %q_31 = qco.rz(%cst_1) %q_30 : !qco.qubit
        qco.yield %q_31 : !qco.qubit
      } else args(%q_28 = %q_17) {
        qco.yield %q_28 : !qco.qubit
      }
      scf.yield %linearResults, %q_26, %q_27 : !qco.qubit, !qco.qubit, !qco.qubit
    }
    qco.sink %q_4 : !qco.qubit
    qco.sink %q_5 : !qco.qubit
    qco.sink %q_6 : !qco.qubit
    return %c : !cbit.reg<2>
  }
}
