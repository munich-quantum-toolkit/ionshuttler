module attributes {mqt.layout = {initial = array<i64: 0, 1, 2>, input_count = 3 : i64, sites = array<i64: 0, 1, 2>}, mqt.target_env = #mqt.target_env<compilation_target = <sites = [<id = 0>, <id = 1>, <id = 2>], connectivity = all_to_all, couplings = [], native_operations = explicit, operations = [<name = "rx", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "ry", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "rz", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "rxx", arity = <kind = fixed, value = 2>, num_parameters = 1, site_tuples = []>, <name = "measure", arity = <kind = fixed, value = 1>, num_parameters = 0, site_tuples = []>, <name = "reset", arity = <kind = fixed, value = 1>, num_parameters = 0, site_tuples = []>]>, payload_specification = <format = <id = "qco", version = "1.0.0", profile = "", encoding = text>, capabilities = [<id = "forward-branching", value = 0, constraints = []>, <id = "counted-iteration", value = 0, constraints = []>, <id = "conditional-loop", value = 0, constraints = []>], optional_capabilities_known = false>>} {
  func.func @main() -> (!cbit.reg<2>, i8, !cbit.reg<1>) attributes {mqt.entry_point} {
    %cst = arith.constant -3.1415926535897931 : f64
    %cst_0 = arith.constant -1.5707963267948966 : f64
    %c0_i2 = arith.constant 0 : i2
    %false = arith.constant false
    %c0 = arith.constant 0 : index
    %true = arith.constant true
    %c1 = arith.constant 1 : index
    %c2_i64 = arith.constant 2 : i64
    %c0_i8 = arith.constant 0 : i8
    %c1_i8 = arith.constant 1 : i8
    %c2_i8 = arith.constant 2 : i8
    %q = qco.static 0 : !qco.qubit
    %q_1 = qco.static 1 : !qco.qubit
    %q_2 = qco.static 2 : !qco.qubit
    %m = cbit.alloc(#cbit.init<undefined>) {mqt.register_name = "m"} : !cbit.reg<2>
    cbit.write %c0_i2, %m : i2, !cbit.reg<2>
    %stop = cbit.alloc(#cbit.init<undefined>) {mqt.register_name = "stop"} : !cbit.reg<1>
    cbit.store %false, %stop[%c0] : !cbit.reg<1>
    %q_3, %b = qco.measure %q : !qco.qubit
    cbit.store %b, %m[%c0] : !cbit.reg<2>
    scf.if %b {
      cbit.store %true, %stop[%c0] : !cbit.reg<1>
    }
    %b_4 = cbit.load %stop[%c0] : !cbit.reg<1>
    qco.sink %q_3 : !qco.qubit
    %classicalResults, %linearResults:2 = qco.if %b_4 args(%q_5 = %q_1, %q_6 = %q_2) -> (i8, !qco.qubit, !qco.qubit) {
      %q_7 = qco.rz(%cst_0) %q_6 : !qco.qubit
      %q_8 = qco.rx(%cst) %q_7 : !qco.qubit
      %q_9 = qco.rz(%cst_0) %q_8 : !qco.qubit
      qco.yield %c0_i8, %q_5, %q_9 : i8, !qco.qubit, !qco.qubit
    } else args(%q_5 = %q_1, %q_6 = %q_2) {
      %q_7, %b_8 = qco.measure %q_5 : !qco.qubit
      cbit.store %b_8, %m[%c1] : !cbit.reg<2>
      %0 = arith.select %b_8, %c2_i8, %c1_i8 : i8
      %1 = arith.extsi %0 : i8 to i64
      %2 = arith.cmpi sge, %1, %c2_i64 : i64
      %linearResults_9 = qco.if %2 args(%q_10 = %q_6) -> (!qco.qubit) {
        %q_11 = qco.rz(%cst_0) %q_10 : !qco.qubit
        %q_12 = qco.rx(%cst) %q_11 : !qco.qubit
        %q_13 = qco.rz(%cst_0) %q_12 : !qco.qubit
        qco.yield %q_13 : !qco.qubit
      } else args(%q_10 = %q_6) {
        qco.yield %q_10 : !qco.qubit
      }
      qco.yield %0, %q_7, %linearResults_9 : i8, !qco.qubit, !qco.qubit
    }
    qco.sink %linearResults#0 : !qco.qubit
    qco.sink %linearResults#1 : !qco.qubit
    return %m, %classicalResults, %stop : !cbit.reg<2>, i8, !cbit.reg<1>
  }
}
