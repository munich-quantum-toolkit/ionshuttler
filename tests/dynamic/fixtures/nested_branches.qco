module attributes {mqt.layout = {initial = array<i64: 0, 1, 2>, input_count = 3 : i64, sites = array<i64: 0, 1, 2>}, mqt.target_env = #mqt.target_env<compilation_target = <sites = [<id = 0>, <id = 1>, <id = 2>], connectivity = all_to_all, couplings = [], native_operations = explicit, operations = [<name = "rx", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "ry", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "rz", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "rxx", arity = <kind = fixed, value = 2>, num_parameters = 1, site_tuples = []>, <name = "measure", arity = <kind = fixed, value = 1>, num_parameters = 0, site_tuples = []>, <name = "reset", arity = <kind = fixed, value = 1>, num_parameters = 0, site_tuples = []>]>, payload_specification = <format = <id = "qco", version = "1.0.0", profile = "", encoding = text>, capabilities = [<id = "forward-branching", value = 0, constraints = []>, <id = "counted-iteration", value = 0, constraints = []>, <id = "conditional-loop", value = 0, constraints = []>], optional_capabilities_known = false>>} {
  func.func @main() -> !cbit.reg<2> attributes {mqt.entry_point} {
    %cst = arith.constant 1.5707963267948966 : f64
    %cst_0 = arith.constant -1.5707963267948966 : f64
    %cst_1 = arith.constant -3.1415926535897931 : f64
    %c0_i2 = arith.constant 0 : i2
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %q = qco.static 0 : !qco.qubit
    %q_2 = qco.static 1 : !qco.qubit
    %q_3 = qco.static 2 : !qco.qubit
    %c = cbit.alloc(#cbit.init<undefined>) {mqt.register_name = "c"} : !cbit.reg<2>
    cbit.write %c0_i2, %c : i2, !cbit.reg<2>
    %q_4 = qco.rz(%cst) %q : !qco.qubit
    %q_5 = qco.rx(%cst) %q_4 : !qco.qubit
    %q_6 = qco.rz(%cst) %q_5 : !qco.qubit
    %q_7, %b = qco.measure %q_6 : !qco.qubit
    cbit.store %b, %c[%c0] : !cbit.reg<2>
    %linearResults:2 = qco.if %b args(%q_16 = %q_2, %q_17 = %q_3) -> (!qco.qubit, !qco.qubit) {
      %q_18 = qco.rz(%cst) %q_16 : !qco.qubit
      %q_19 = qco.rx(%cst) %q_18 : !qco.qubit
      %q_20 = qco.rz(%cst) %q_19 : !qco.qubit
      %q_21, %b_22 = qco.measure %q_20 : !qco.qubit
      cbit.store %b_22, %c[%c1] : !cbit.reg<2>
      %linearResults_23:2 = qco.if %b_22 args(%q_24 = %q_21, %q_25 = %q_17) -> (!qco.qubit, !qco.qubit) {
        %q_26 = qco.rz(%cst_0) %q_25 : !qco.qubit
        %q_27 = qco.rx(%cst_1) %q_26 : !qco.qubit
        %q_28 = qco.rz(%cst_0) %q_27 : !qco.qubit
        qco.yield %q_24, %q_28 : !qco.qubit, !qco.qubit
      } else args(%q_24 = %q_21, %q_25 = %q_17) {
        %q_26 = qco.rz(%cst_1) %q_25 : !qco.qubit
        %q_27 = qco.rz(%cst_0) %q_24 : !qco.qubit
        %q_28 = qco.rx(%cst) %q_27 : !qco.qubit
        %q_29 = qco.rz(%cst) %q_28 : !qco.qubit
        %qubit0_out_30, %qubit1_out_31 = qco.rxx(%cst_0) %q_29, %q_26 : !qco.qubit, !qco.qubit
        %q_32 = qco.rx(%cst) %qubit1_out_31 : !qco.qubit
        %q_33 = qco.rz(%cst_1) %q_32 : !qco.qubit
        %q_34 = qco.rz(%cst_0) %qubit0_out_30 : !qco.qubit
        %q_35 = qco.rx(%cst_0) %q_34 : !qco.qubit
        qco.yield %q_35, %q_33 : !qco.qubit, !qco.qubit
      }
      qco.yield %linearResults_23#0, %linearResults_23#1 : !qco.qubit, !qco.qubit
    } else args(%q_16 = %q_2, %q_17 = %q_3) {
      qco.yield %q_16, %q_17 : !qco.qubit, !qco.qubit
    }
    qco.sink %linearResults#0 : !qco.qubit
    %q_8 = qco.rz(%cst_1) %linearResults#1 : !qco.qubit
    %q_9 = qco.rz(%cst_0) %q_7 : !qco.qubit
    %q_10 = qco.rx(%cst) %q_9 : !qco.qubit
    %q_11 = qco.rz(%cst) %q_10 : !qco.qubit
    %qubit0_out, %qubit1_out = qco.rxx(%cst_0) %q_11, %q_8 : !qco.qubit, !qco.qubit
    %q_12 = qco.rx(%cst) %qubit1_out : !qco.qubit
    %q_13 = qco.rz(%cst_1) %q_12 : !qco.qubit
    %q_14 = qco.rz(%cst_0) %qubit0_out : !qco.qubit
    %q_15 = qco.rx(%cst_0) %q_14 : !qco.qubit
    qco.sink %q_13 : !qco.qubit
    qco.sink %q_15 : !qco.qubit
    return %c : !cbit.reg<2>
  }
}
