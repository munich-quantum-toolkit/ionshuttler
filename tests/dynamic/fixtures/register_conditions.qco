module attributes {mqt.layout = {initial = array<i64: 0, 1, 2>, input_count = 3 : i64, sites = array<i64: 0, 1, 2>}, mqt.target_env = #mqt.target_env<compilation_target = <sites = [<id = 0>, <id = 1>, <id = 2>], connectivity = all_to_all, couplings = [], native_operations = explicit, operations = [<name = "rx", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "ry", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "rz", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "rxx", arity = <kind = fixed, value = 2>, num_parameters = 1, site_tuples = []>, <name = "measure", arity = <kind = fixed, value = 1>, num_parameters = 0, site_tuples = []>, <name = "reset", arity = <kind = fixed, value = 1>, num_parameters = 0, site_tuples = []>]>, payload_specification = <format = <id = "qco", version = "1.0.0", profile = "", encoding = text>, capabilities = [<id = "forward-branching", value = 0, constraints = []>, <id = "counted-iteration", value = 0, constraints = []>, <id = "conditional-loop", value = 0, constraints = []>], optional_capabilities_known = false>>} {
  func.func @main() -> !cbit.reg<2> attributes {mqt.entry_point} {
    %cst = arith.constant 1.5707963267948966 : f64
    %cst_0 = arith.constant -1.5707963267948966 : f64
    %cst_1 = arith.constant -3.1415926535897931 : f64
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c-1_i2 = arith.constant -1 : i2
    %q = qco.static 0 : !qco.qubit
    %q_2 = qco.static 1 : !qco.qubit
    %q_3 = qco.static 2 : !qco.qubit
    %c = cbit.alloc(#cbit.init<undefined>) {mqt.register_name = "c"} : !cbit.reg<2>
    %q_4 = qco.rz(%cst) %q : !qco.qubit
    %q_5 = qco.rx(%cst) %q_4 : !qco.qubit
    %q_6 = qco.rz(%cst) %q_5 : !qco.qubit
    %q_7 = qco.rz(%cst) %q_2 : !qco.qubit
    %q_8 = qco.rx(%cst) %q_7 : !qco.qubit
    %q_9 = qco.rz(%cst) %q_8 : !qco.qubit
    %q_10, %b = qco.measure %q_6 : !qco.qubit
    cbit.store %b, %c[%c0] : !cbit.reg<2>
    %q_11, %b_12 = qco.measure %q_9 : !qco.qubit
    cbit.store %b_12, %c[%c1] : !cbit.reg<2>
    %val = cbit.read %c : !cbit.reg<2> -> i2
    %0 = arith.cmpi eq, %val, %c-1_i2 : i2
    qco.sink %q_10 : !qco.qubit
    qco.sink %q_11 : !qco.qubit
    %linearResults = qco.if %0 args(%q_16 = %q_3) -> (!qco.qubit) {
      %q_17 = qco.rz(%cst_0) %q_16 : !qco.qubit
      %q_18 = qco.rx(%cst_1) %q_17 : !qco.qubit
      %q_19 = qco.rz(%cst_0) %q_18 : !qco.qubit
      qco.yield %q_19 : !qco.qubit
    } else args(%q_16 = %q_3) {
      qco.yield %q_16 : !qco.qubit
    }
    %b_13 = cbit.load %c[%c0] : !cbit.reg<2>
    %b_14 = cbit.load %c[%c1] : !cbit.reg<2>
    %1 = arith.cmpi ne, %b_13, %b_14 : i1
    %linearResults_15 = qco.if %1 args(%q_16 = %linearResults) -> (!qco.qubit) {
      %q_17 = qco.rz(%cst_1) %q_16 : !qco.qubit
      qco.yield %q_17 : !qco.qubit
    } else args(%q_16 = %linearResults) {
      qco.yield %q_16 : !qco.qubit
    }
    qco.sink %linearResults_15 : !qco.qubit
    return %c : !cbit.reg<2>
  }
}
