module attributes {mqt.layout = {initial = array<i64: 2, 0, 1>, input_count = 3 : i64, sites = array<i64: 0, 1, 2>}, mqt.target_env = #mqt.target_env<compilation_target = <sites = [<id = 0>, <id = 1>, <id = 2>], connectivity = all_to_all, couplings = [], native_operations = explicit, operations = [<name = "rx", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "ry", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "rz", arity = <kind = fixed, value = 1>, num_parameters = 1, site_tuples = []>, <name = "rxx", arity = <kind = fixed, value = 2>, num_parameters = 1, site_tuples = []>, <name = "measure", arity = <kind = fixed, value = 1>, num_parameters = 0, site_tuples = []>, <name = "reset", arity = <kind = fixed, value = 1>, num_parameters = 0, site_tuples = []>]>, payload_specification = <format = <id = "qco", version = "1.0.0", profile = "", encoding = text>, capabilities = [<id = "forward-branching", value = 0, constraints = []>, <id = "counted-iteration", value = 0, constraints = []>, <id = "conditional-loop", value = 0, constraints = []>], optional_capabilities_known = false>>} {
  func.func @main() -> !cbit.reg<2> attributes {mqt.entry_point} {
    %cst = arith.constant 1.5707963267948966 : f64
    %cst_0 = arith.constant -1.5707963267948966 : f64
    %cst_1 = arith.constant -3.1415926535897931 : f64
    %c1 = arith.constant 1 : index
    %c0 = arith.constant 0 : index
    %q = qco.static 0 : !qco.qubit
    %q_2 = qco.static 1 : !qco.qubit
    %q_3 = qco.static 2 : !qco.qubit
    %c = cbit.alloc(#cbit.init<undefined>) {mqt.register_name = "c"} : !cbit.reg<2>
    %q_4 = qco.rz(%cst) %q : !qco.qubit
    %q_5 = qco.rx(%cst_1) %q_4 : !qco.qubit
    %q_6 = qco.rz(%cst) %q_5 : !qco.qubit
    %q_7 = qco.rz(%cst_1) %q_2 : !qco.qubit
    %qubit0_out, %qubit1_out = qco.rxx(%cst_0) %q_6, %q_7 : !qco.qubit, !qco.qubit
    %q_8 = qco.rx(%cst) %qubit1_out : !qco.qubit
    %q_9 = qco.rz(%cst_1) %q_8 : !qco.qubit
    %q_10 = qco.rz(%cst) %qubit0_out : !qco.qubit
    %q_11 = qco.rx(%cst) %q_10 : !qco.qubit
    %q_12 = qco.rz(%cst_0) %q_3 : !qco.qubit
    %q_13 = qco.rx(%cst) %q_12 : !qco.qubit
    %q_14 = qco.rz(%cst) %q_13 : !qco.qubit
    %qubit0_out_15, %qubit1_out_16 = qco.rxx(%cst_0) %q_14, %q_11 : !qco.qubit, !qco.qubit
    %q_17 = qco.rx(%cst) %qubit1_out_16 : !qco.qubit
    %q_18 = qco.rz(%cst_1) %q_17 : !qco.qubit
    %q_19 = qco.rx(%cst) %qubit0_out_15 : !qco.qubit
    %q_20, %b = qco.measure %q_19 : !qco.qubit
    qco.sink %q_20 : !qco.qubit
    cbit.store %b, %c[%c0] : !cbit.reg<2>
    %q_21, %b_22 = qco.measure %q_18 : !qco.qubit
    qco.sink %q_21 : !qco.qubit
    cbit.store %b_22, %c[%c1] : !cbit.reg<2>
    %linearResults = qco.if %b_22 args(%q_25 = %q_9) -> (!qco.qubit) {
      %q_26 = qco.rz(%cst_0) %q_25 : !qco.qubit
      %q_27 = qco.rx(%cst_1) %q_26 : !qco.qubit
      %q_28 = qco.rz(%cst_0) %q_27 : !qco.qubit
      qco.yield %q_28 : !qco.qubit
    } else args(%q_25 = %q_9) {
      qco.yield %q_25 : !qco.qubit
    }
    %b_23 = cbit.load %c[%c0] : !cbit.reg<2>
    %linearResults_24 = qco.if %b_23 args(%q_25 = %linearResults) -> (!qco.qubit) {
      %q_26 = qco.rz(%cst_1) %q_25 : !qco.qubit
      qco.yield %q_26 : !qco.qubit
    } else args(%q_25 = %linearResults) {
      qco.yield %q_25 : !qco.qubit
    }
    qco.sink %linearResults_24 : !qco.qubit
    return %c : !cbit.reg<2>
  }
}
